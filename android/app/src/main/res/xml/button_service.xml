<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка Bixby + сигнал активности для сна (клики, прокрутка, ввод). Содержимое окон не читается. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeViewScrolled|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="1000"
    android:description="@string/button_service_description" />
